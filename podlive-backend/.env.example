# =============================================
# PodLive Backend - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file!
# =============================================

# PostgreSQL Database (Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets (use long random strings in production)
JWT_ACCESS_SECRET="your-strong-access-secret-here"
JWT_REFRESH_SECRET="your-strong-refresh-secret-here"

# Trusted CHEETCHAT backend used to verify short-lived, one-time SSO tickets.
CHEETCHAT_API_URL="https://chietchat-backend.onrender.com"

# Server Port
PORT=5005
# Estimated creator revenue per qualified view, stored in paise (3 = Rs 0.03).
MONETIZATION_PAISE_PER_QUALIFIED_VIEW=3
# Legacy multipart/chunk upload ceiling.
MAX_UPLOAD_SIZE_BYTES=5368709120
# Direct/resumable uploads go from the browser straight to Bunny Stream.
DIRECT_UPLOAD_MAX_SIZE_BYTES=5368709120
UPLOAD_CHUNK_MAX_BYTES=33554432
# Browser can upload this many chunks together; 4 is a safe default.
UPLOAD_PARALLEL_CHUNKS=4
HLS_SEGMENT_SECONDS=10

# Bunny Stream (video uploads and VOD streaming)
BUNNY_STREAM_LIBRARY_ID="your-bunny-stream-library-id"
BUNNY_STREAM_ACCESS_KEY="your-bunny-stream-library-api-key"
BUNNY_STREAM_CDN_HOSTNAME="vz-your-library-hostname.b-cdn.net"
# Optional
BUNNY_STREAM_COLLECTION_ID=""
BUNNY_STREAM_ENABLED_RESOLUTIONS="240p,360p,480p,720p,1080p"
BUNNY_STREAM_OUTPUT_CODECS="x264"
BUNNY_STREAM_STATUS_SYNC_ATTEMPTS=360
# Faster readiness detection; playback is still served directly by Bunny's CDN.
BUNNY_STREAM_STATUS_SYNC_INTERVAL_MS=5000
BUNNY_TUS_AUTH_SECONDS=86400
BUNNY_TUS_CHUNK_SIZE_BYTES=33554432

# LiveKit Cloud (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# PodLive live rooms are real-time only. No recording/HLS egress is available.
ENABLE_LIVEKIT_INGRESS=false
